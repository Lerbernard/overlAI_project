<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The package name comes from `namespace` in build.gradle.kts; the old package= attribute
         here is deprecated and ignored by AGP 8. -->

    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <!-- persistent "overlay is on" foreground service -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- allowBackup=false: History thumbnails, cached scores and the premium cache stay on the
         device and are never copied into Google's cloud backup or device-to-device transfer. -->
    <application
        android:allowBackup="false"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.Test103">

        <!-- AdMob App ID. Ads are compiled out (BuildConfig.ADS_ENABLED = false) so the SDK never
             initialises; this is Google's official sample ID, which the SDK requires to be present.
             Replace with the real App ID from the AdMob console before turning ads on. -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-3940256099942544~3347511713" />
        <!-- The SDK is never initialised in this build; skip its automatic startup too. -->
        <meta-data
            android:name="com.google.android.gms.ads.DELAY_APP_MEASUREMENT_INIT"
            android:value="true" />


        <activity android:name=".MainActivity" android:exported="true" />

        <!-- switchable launcher icon: exactly one alias is enabled at a time.
             The Settings icon preview toggles between them. -->
        <activity-alias
            android:name=".LauncherDark"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherLight"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_light"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- SHARE TARGET: OverlAI appears in the system share sheet for images and videos -->
        <activity
            android:name=".ShareDetectActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:label="Check with OverlAI">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="video/*" />
            </intent-filter>
        </activity>

        <!-- Overlay flow: own task so it never drags the app to the foreground -->
        <activity
            android:name=".ScreenshotActivity"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true"
            android:exported="false"
            android:taskAffinity=""
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize" />

        <!-- Detector-tab crop: normal task so fragments get their result -->
        <activity
            android:name=".CropActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen" />

        <!-- specialUse = persistent overlay notification;
             mediaProjection type is added only during captures -->
        <service
            android:name=".OverlayService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="mediaProjection|specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Screen overlay tool for on-demand AI-content detection" />
        </service>

        <!-- QUICK SETTINGS TILE -->
        <service
            android:name=".OverlayTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile"
            android:label="OverlAI"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- HOME SCREEN WIDGETS. The providers are exported because the launcher must reach
             them, but they only handle the system's APPWIDGET_* events. The toggle button goes
             through WidgetActionReceiver below, which nothing outside this app can send to. -->
        <receiver
            android:name=".OverlayWidgetProvider"
            android:exported="true"
            android:enabled="false"
            android:label="OverlAI">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/overlay_widget_info" />
        </receiver>
        <receiver
            android:name=".OverlayStatsWidget"
            android:exported="true"
            android:enabled="false"
            android:label="OverlAI Dashboard">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_stats_info" />
        </receiver>
        <receiver
            android:name=".WidgetActionReceiver"
            android:exported="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <service
            android:name=".QuickShotService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="mediaProjection|specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="One-tap screenshot AI check from quick settings" />
        </service>

        <service
            android:name=".QuickCheckTile"
            android:exported="true"
            android:icon="@drawable/ic_nav_detector"
            android:label="Quick check"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

    </application>
</manifest>
