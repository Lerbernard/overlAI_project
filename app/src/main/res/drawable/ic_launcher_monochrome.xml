<?xml version="1.0" encoding="utf-8"?>
<!-- res/drawable/ic_launcher_monochrome.xml
     Material You fills this as ONE white silhouette, so it must read as a
     single recognizable mark: a lens ring with a solid center dot, sized
     inside the 66dp adaptive safe zone. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp" android:height="108dp"
    android:viewportWidth="108" android:viewportHeight="108">
    <!-- ring: an annulus via even-odd (outer circle minus inner circle) -->
    <path android:fillColor="#FFFFFFFF" android:fillType="evenOdd"
        android:pathData="M54,32
                          a22,22 0 1 0 0.01,0 Z
                          M54,41
                          a13,13 0 1 1 -0.01,0 Z" />
    <!-- solid center dot -->
    <path android:fillColor="#FFFFFFFF"
        android:pathData="M54,54 m-6,0 a6,6 0 1 0 12,0 a6,6 0 1 0 -12,0" />
</vector>
