<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@android:color/transparent">

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/subTabLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:tabMode="fixed"
        app:tabGravity="fill"
        app:tabIndicatorColor="@color/lm_tab_indicator"
        app:tabSelectedTextColor="@color/lm_tab_indicator"
        app:tabTextColor="@color/lm_tab_text"
        app:tabIndicatorHeight="4dp">

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Image" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Video" />
    </com.google.android.material.tabs.TabLayout>

    <!-- IMAGE PANEL -->
    <FrameLayout
        android:id="@+id/imagePanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="20dp"
            android:gravity="center">

            <!-- ✅ Rounded image preview, fits full image -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/imagePreviewCard"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:visibility="gone"
                android:layout_marginBottom="20dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <ImageView
                    android:id="@+id/imagePreview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:adjustViewBounds="true"
                    android:scaleType="fitCenter"
                    android:contentDescription="Image preview" />

            </com.google.android.material.card.MaterialCardView>

            <!-- Buttons always centered at bottom -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPickImage"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="Select Image"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:layout_marginBottom="12dp"
                    app:backgroundTint="@color/lm_primary"
                    app:cornerRadius="30dp"
                    app:elevation="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCheckImage"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="Check Image"
                    android:textAllCaps="false"
                    android:textColor="@color/lm_btn_secondary_text"
                    android:enabled="false"
                    android:visibility="gone"
                    android:layout_marginBottom="16dp"
                    app:backgroundTint="@color/lm_btn_secondary"
                    app:cornerRadius="30dp"
                    app:strokeWidth="0dp" />

                <TextView
                    android:id="@+id/imageResultText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="48sp"
                    android:textStyle="bold"
                    android:textColor="@color/lm_text_primary"
                    android:gravity="center"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/imageStatusText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textColor="@color/lm_text_secondary"
                    android:gravity="center" />

            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- VIDEO PANEL -->
    <FrameLayout
        android:id="@+id/videoPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="20dp"
            android:gravity="center">

            <!-- ✅ Rounded video preview, fits full video -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/videoContainer"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:visibility="gone"
                android:layout_marginBottom="20dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <VideoView
                    android:id="@+id/videoPreview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center" />

            </com.google.android.material.card.MaterialCardView>

            <!-- Buttons always centered at bottom -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPickVideo"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="Select Video"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:layout_marginBottom="12dp"
                    app:backgroundTint="@color/lm_primary"
                    app:cornerRadius="30dp"
                    app:elevation="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCheckVideo"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="Check Video"
                    android:textAllCaps="false"
                    android:textColor="@color/lm_btn_secondary_text"
                    android:enabled="false"
                    android:visibility="gone"
                    android:layout_marginBottom="16dp"
                    app:backgroundTint="@color/lm_btn_secondary"
                    app:cornerRadius="30dp"
                    app:strokeWidth="0dp" />

                <TextView
                    android:id="@+id/videoResultText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="48sp"
                    android:textStyle="bold"
                    android:textColor="@color/lm_text_primary"
                    android:gravity="center"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/videoStatusText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textColor="@color/lm_text_secondary"
                    android:gravity="center" />

            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

</LinearLayout>