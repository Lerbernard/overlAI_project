<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: nothing from this app goes into cloud backups or device-to-device transfers.
     History thumbnails, cached scores and the premium cache stay on the phone they were made on.
     (allowBackup="false" in the manifest covers older versions; this makes it explicit on 12+.) -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
